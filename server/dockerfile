# Use slim Python image
FROM python:3.10-slim

# Install build-essential for compiling some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends build-essential

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libsqlite3-dev \
    libasound-dev \
    ffmpeg \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create upload directory with proper quoting for spaces
RUN mkdir -p "/app/Interview Uploads" && chmod 777 "/app/Interview Uploads"

# Set working directory
WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy requirements and install main dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/whisper-diarization/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
# Copy the entire application code
COPY . .
# Setup an app user so the container doesn't run as the root user
RUN useradd app && chown -R app:app /app
USER app

# Run FastAPI server
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
