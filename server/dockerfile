FROM python:3.11-slim AS builder

# Set the working directory
WORKDIR /app

# Install build-essential for compiling some Python packages
RUN apt-get update && apt-get install -y --no-install-recommends build-essential

RUN apt-get update && apt-get install -y ffmpeg

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libsqlite3-dev \
    libasound-dev\
    ffmpeg\
    curl \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*
    
# Copy requirements file
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip


# This command downloads all wheels and source distributions into /app/wheels.
# This is the only step that hits the network for Python packages.
RUN pip download --dest /app/wheels -r requirements.txt


# This installs the packages from the /app/wheels directory without re-downloading.
# This step is very fast and makes 'spacy' available for the next command.
RUN pip install --no-cache-dir --no-index --find-links=/app/wheels -r requirements.txt

# Now that spacy is installed, download the model
# RUN python -m spacy download en_core_web_sm


# --- Stage 2: Final Production Image ---
# This stage builds the lean final image using artifacts from the builder stage.
FROM python:3.11-slim

# Create a non-root user and group for security
RUN groupadd -r app && useradd -r -g app app

# Set the working directory
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-downloaded wheels, SpaCy model, and requirements file from the builder stage
COPY --from=builder /app/wheels /wheels/


COPY --from=builder /app/requirements.txt .

# Install the Python dependencies from the local wheels. This is very fast.
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt



# Copy the entire 'app' directory
COPY app ./app

COPY scripts ./scripts


# Change ownership of the app directory to the non-root user
RUN chown -R app:app /app

# Set the home for the huggingface cache and change ownership
ENV HF_HOME=/home/app/.cache/huggingface
RUN mkdir -p $HF_HOME && chown -R app:app /home/app

# Switch to the non-root user
USER app


# Expose the port the app runs on
EXPOSE 8000


CMD ["python", "/app/start.py"]
