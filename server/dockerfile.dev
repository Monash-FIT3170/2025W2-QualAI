# --- Development Backend Dockerfile ---
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies once - ADDED MISSING DEPENDENCIES
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsqlite3-dev \
    libasound2 \
    ffmpeg \
    curl \
    git \
    wget \
    ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN mkdir -p "/app/Interview Uploads" && chmod 777 "/app/Interview Uploads"

# Install core dependencies first
RUN pip install --no-cache-dir python-dotenv
RUN pip install --no-cache-dir cython
RUN pip install --no-cache-dir faster-whisper

# Install pip + requirements - FIXED ORDER
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Install whisper-diarization requirements - FIXED PATH
COPY app/whisper-diarization/requirements.txt ./whisper-requirements.txt
RUN pip install --no-cache-dir -r whisper-requirements.txt

# Copy application code (if needed, otherwise remove since you use volumes)
COPY app/ .

RUN useradd app && chown -R app:app /app
USER app

EXPOSE 8000

CMD ["python", "start.py"]